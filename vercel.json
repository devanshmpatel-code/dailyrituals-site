{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/product-page/:slug", "destination": "/product/:slug", "permanent": true },
    { "source": "/category/:path*", "destination": "/shop", "permanent": true },
    { "source": "/shop-1", "destination": "/shop", "permanent": true },
    { "source": "/service-page/:slug", "destination": "/book/:slug", "permanent": true },
    { "source": "/book-online", "destination": "/coaching", "permanent": true },
    { "source": "/booking-calendar/:path*", "destination": "/coaching", "permanent": true },
    { "source": "/about", "destination": "/story", "permanent": true },
    { "source": "/about-us", "destination": "/story", "permanent": true },
    { "source": "/contact", "destination": "/help", "permanent": true },
    { "source": "/contact-us", "destination": "/help", "permanent": true },
    { "source": "/faq", "destination": "/help", "permanent": true },
    { "source": "/cart-page", "destination": "/checkout", "permanent": true },
    { "source": "/account/:path+", "destination": "/account", "permanent": true },
    { "source": "/blank", "destination": "/", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "(www\\.)?dailyritualsco\\.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
