VITE_WIX_CLIENT_ID=c7b1b1ef-a707-4acf-82c3-771363e5a27f
# Optional. Staff resource type id of the Wix project being read (defaults to the current live site's).
# VITE_STAFF_RESOURCE_TYPE_ID=
# Leave off until launch. When true, checkout and booking write to the live Wix site.
VITE_ENABLE_WRITES=false
# Production only, on the real domain: removes the preview bar and lets search engines index the site. See LAUNCH.md.
# VITE_LAUNCH=true
# Routing defaults to real addresses (/shop). Set to "hash" only for hosts that cannot serve index.html for every path.
# VITE_ROUTING=hash
